# Dormitory Management System Environment Configuration

# Server Port
PORT=8080

# Environment: development or production
ENV=development

# Database Driver: postgres or sqlite
# Use "sqlite" for zero-dependency local testing on Windows
# Use "postgres" for production, Docker, or Cloud Hosting (Render, Neon, Supabase)
DB_DRIVER=sqlite

# PostgreSQL Connection Details (Used when DB_DRIVER=postgres)
# Or set a single full connection string in DATABASE_URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dormitory_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dormitory_db
DB_SSLMODE=disable

# Cryptographic Session Secret (At least 32 characters)
SESSION_SECRET=super-secret-random-key-dormitory-2026-min-32-chars!

# Initial Admin Credentials (Generated automatically on first launch if not exists)
ADMIN_NAME=Dormitory Administrator
ADMIN_EMAIL=admin@dormitory.com
ADMIN_PASSWORD=admin123456

# File Upload Storage Directory
UPLOAD_DIR=./uploads
